# SatQuery AI — Production Environment Configuration (§97)

# Django Core
DJANGO_SECRET_KEY=django-insecure-satquery-ai-prod-key-2026
DJANGO_DEBUG=True
ALLOWED_HOSTS=*

# Database (PostgreSQL with PostGIS)
DATABASE_URL=postgresql://satquery:satquery_dev_password@localhost:5432/satquery

# Redis (Celery Broker, Results & Pub/Sub)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0

# Copernicus Data Space Ecosystem (CDSE)
CDSE_USERNAME=
CDSE_PASSWORD=
CDSE_CLIENT_ID=cdse-public

# OpenAI (Optional Reasoning & VLM Provider)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Hugging Face (Optional Remote Inference)
HF_TOKEN=

# Map Provider (Optional Vector Basemap Provider)
MAPTILER_API_KEY=

# Object Storage (S3 / MinIO Compatible)
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadminpassword
S3_BUCKET=satquery-imagery

# Platform Operation Mode (production | demo)
SATQUERY_MODE=demo
