# SatQuery AI — Environment Variables Template (§17)

# Django Core
DJANGO_SECRET_KEY=dev-secret-key-satquery-ai-sih26167-production-grade
DJANGO_DEBUG=True
ALLOWED_HOSTS=*

# Database (PostgreSQL with PostGIS)
DATABASE_URL=postgresql://satquery:satquery_dev_password@localhost:5432/satquery

# Redis (Celery Broker, Result Backend & SSE Event Pub/Sub)
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# MinIO / S3 Object Storage
MINIO_ENDPOINT=localhost:9000
MINIO_KEY=minioadmin
MINIO_SECRET=minioadminpassword
MINIO_BUCKET=satquery-imagery

# Copernicus Data Space Ecosystem (STAC API)
COPERNICUS_CLIENT_ID=your_copernicus_client_id_here
COPERNICUS_CLIENT_SECRET=your_copernicus_client_secret_here

# JWT Signing
JWT_SIGNING_KEY=jwt-secret-key-satquery-ai-sih26167
