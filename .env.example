# SatQuery-X environment configuration
SATQUERY_ENV=development
SATQUERY_SECRET_KEY=change-me-in-production
SATQUERY_JWT_SECRET=change-me-jwt-secret

# Database
DATABASE_URL=postgresql+asyncpg://satquery:satquery@localhost:5432/satquery
DATABASE_URL_SYNC=postgresql://satquery:satquery@localhost:5432/satquery

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# MinIO / S3
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=satquery
S3_REGION=us-east-1

# Planner LLM (optional — rule-based fallback when unset)
PLANNER_LLM_PROVIDER=openai
OPENAI_API_KEY=
PLANNER_MODEL=gpt-4o-mini

# Model serving
MODEL_DEVICE=cpu
RS_VQA_MODEL=Salesforce/blip-vqa-base
RS_CAPTION_MODEL=Salesforce/blip-image-captioning-base

# Upload limits
MAX_UPLOAD_SIZE_MB=100
